---
import '@/styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import GotoTop from '@/components/common/GotoTop.astro';
import SEO from '@/components/SEO.astro';

type Props = {
  title?: string;
  description?: string;
  ogImage?: URL;
};

const props = Astro.props;
---

<html lang="en">
  <head>
    <SEO {...props} />
    <ClientRouter />
  </head>
  <body
    class:list={["min-h-screen bg-background font-sans antialiased", "default"]}
  >
    <div class="relative flex min-h-screen flex-col">
      <main class="flex-auto">
        <slot />
      </main>
    </div>
    <GotoTop />
  </body>
</html>

<script>
  console.log("https://github.com/sohanemon/astro-template");
</script>
